import java.util.Scanner;

public class StockTradingPlatform {

    static String[] stocks = {
        "AAPL",
        "GOOG",
        "TSLA",
        "AMZN"
    };

    static double[] prices = {
        180.50,
        175.20,
        250.75,
        185.30
    };

    static int[] shares = {
        0, 0, 0, 0
    };

    static double balance = 10000;

    // Function to display stocks
    static void displayStocks() {

        System.out.println("\n========== MARKET ==========");

        for (int i = 0; i < stocks.length; i++) {

            System.out.println(
                (i + 1) + ". " +
                stocks[i] +
                " - $" +
                prices[i]
            );
        }
    }

    // Function to buy stock
    static void buyStock(int stockNumber, int quantity) {

        int index = stockNumber - 1;

        if (index < 0 || index >= stocks.length) {
            System.out.println("Invalid stock!");
            return;
        }

        double amount = prices[index] * quantity;

        if (amount > balance) {
            System.out.println("Insufficient balance!");
            return;
        }

        balance -= amount;
        shares[index] += quantity;

        System.out.println(
            "Successfully bought " +
            quantity + " shares of " +
            stocks[index]
        );
    }

    // Function to sell stock
    static void sellStock(int stockNumber, int quantity) {

        int index = stockNumber - 1;

        if (index < 0 || index >= stocks.length) {
            System.out.println("Invalid stock!");
            return;
        }

        if (quantity > shares[index]) {
            System.out.println("Not enough shares!");
            return;
        }

        double amount = prices[index] * quantity;

        shares[index] -= quantity;
        balance += amount;

        System.out.println(
            "Successfully sold " +
            quantity + " shares of " +
            stocks[index]
        );
    }

    // Function to calculate portfolio value
    static double calculatePortfolioValue() {

        double value = balance;

        for (int i = 0; i < stocks.length; i++) {
            value += shares[i] * prices[i];
        }

        return value;
    }

    // Function to display portfolio
    static void displayPortfolio() {

        System.out.println("\n========== PORTFOLIO ==========");

        System.out.println(
            "Cash Balance: $" + balance
        );

        for (int i = 0; i < stocks.length; i++) {

            if (shares[i] > 0) {

                double value =
                    shares[i] * prices[i];

                System.out.println(
                    stocks[i] +
                    " | Shares: " +
                    shares[i] +
                    " | Value: $" +
                    value
                );
            }
        }

        System.out.println(
            "Total Portfolio: $" +
            calculatePortfolioValue()
        );
    }

    // Function to display menu
    static void displayMenu() {

        System.out.println("\n===== STOCK TRADING PLATFORM =====");
        System.out.println("1. Display Market");
        System.out.println("2. Buy Stock");
        System.out.println("3. Sell Stock");
        System.out.println("4. View Portfolio");
        System.out.println("5. Exit");
    }

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        int choice;

        do {

            displayMenu();

            System.out.print("Enter choice: ");
            choice = sc.nextInt();

            switch (choice) {

                case 1:

                    displayStocks();
                    break;

                case 2:

                    displayStocks();

                    System.out.print(
                        "Enter stock number: "
                    );

                    int buyStock = sc.nextInt();

                    System.out.print(
                        "Enter quantity: "
                    );

                    int buyQuantity = sc.nextInt();

                    buyStock(buyStock, buyQuantity);

                    break;

                case 3:

                    displayStocks();

                    System.out.print(
                        "Enter stock number: "
                    );

                    int sellStock = sc.nextInt();

                    System.out.print(
                        "Enter quantity: "
                    );

                    int sellQuantity = sc.nextInt();

                    sellStock(sellStock, sellQuantity);

                    break;

                case 4:

                    displayPortfolio();
                    break;

                case 5:

                    System.out.println(
                        "Thank you for using the platform!"
                    );

                    break;

                default:

                    System.out.println(
                        "Invalid choice!"
                    );
            }

        } while (choice != 5);

        sc.close();
    }
}
